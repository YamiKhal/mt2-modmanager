# Every step has a unique id: the save stores finished step ids and resumes from them.
# "building" completes once any single owned region has at least timesNeeded buildings
# with that feature; buildings that already exist count.
mmoSequence
{
	steps
	{
		mmoStepMessage
		{
			id "smiths_intro";
			windowName "tutorial_message";
			text "{milestones_smiths_intro}";
		}
		mmoStepMessage
		{
			id "smiths_goal";
			windowName "tutorial_action";
			type "building";
			buildingFeature "Blacksmith";
			timesNeeded <smiths_needed>;
			text "{milestones_smiths_goal}";
		}
		mmoStepCommand
		{
			id "smiths_reward";
			command "add_cash <smiths_reward>";
		}
		mmoStepMessage
		{
			id "smiths_done";
			windowName "tutorial_message";
			text "{milestones_smiths_done}";
		}
	}
}
