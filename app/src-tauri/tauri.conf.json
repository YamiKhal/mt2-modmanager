{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MT2 Mod Manager",
  "version": "0.5.13",
  "identifier": "com.mt2mm.modmanager",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "MT2 Mod Manager",
        "width": 1180,
        "height": 780,
        "minWidth": 860,
        "minHeight": 560,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../mt2-loader/dist/zlib1.dll": "loader/zlib1.dll",
      "../../../mt2-loader/dist/mt2loader/mt2loader.dll": "loader/mt2loader/mt2loader.dll"
    },
    "shortDescription": "Mod manager for MMORPG Tycoon 2",
    "longDescription": "Merges MMORPG Tycoon 2 mods into one load order with namespaced ids and a conflict report."
  }
}
